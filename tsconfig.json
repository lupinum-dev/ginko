{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The runtime composables are type-checked through their tests, against the same shims vitest uses.
    // ginko-components checks its module and runtime with its own `typecheck` (vue-tsc against its .nuxt).
    // Template feature code that scripts/test imports reads the basics by package name, as a template does.
    "paths": { "@lupinum/ginko/basics": ["./packages/ginko/src/basics/index.ts"], "#imports": ["./packages/ginko/test/shims/imports.ts"], "#ginko/schema": ["./packages/ginko/test/shims/schema.ts"], "#convex/api": ["./packages/ginko-server/convex/_generated/api"] }
  },
  "include": ["packages/*/src", "packages/*/test", "scripts"],
  "exclude": ["packages/ginko-server/test", "packages/ginko/src/nuxt/module.ts", "packages/ginko/src/nuxt/runtime", "packages/ginko-i18n/src/module.ts", "packages/ginko-i18n/src/runtime", "packages/ginko-i18n/test/runtime.test.ts", "packages/ginko-components/src/module.ts", "packages/ginko-components/src/runtime", "packages/ginko-components/test/lazy.test.ts", "packages/ginko-studio/test/markdown-editor.test.ts", "packages/ginko-studio/test/component-block.test.ts", "packages/ginko-studio/test/field-upload.test.ts", "packages/ginko-studio/test/ops-proposal.test.ts", "packages/ginko-studio/test/entry-editor.test.ts", "packages/ginko-studio/test/entry-form.test.ts", "packages/ginko-studio/test/task-sheet.test.ts", "packages/ginko-studio/test/files-library.test.ts", "packages/ginko-studio/test/entry-page.test.ts", "packages/ginko-studio/test/site-layout.test.ts", "packages/ginko-studio/test/account-menu.test.ts"]
}
