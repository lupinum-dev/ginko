{
  "name": "@ginko-demo/docs",
  "private": true,
  "type": "module",
  "dependencies": {
    "@lupinum/ginko": "workspace:*",
    "@lupinum/ginko-content": "workspace:*",
    "@lupinum/ginko-docs": "workspace:*",
    "@lupinum/ginko-i18n": "workspace:*",
    "nuxt": "4.6.2",
    "sharp": "^0.35.5",
    "vue": "3.5.44"
  },
  "scripts": {
    "dev": "nuxt dev --port 3500",
    "build": "pnpm --filter @lupinum/ginko-components registry && nuxt build",
    "generate": "pnpm --filter @lupinum/ginko-components registry && nuxt generate",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@takumi-rs/core": "2.17.1",
    "nuxt-og-image": "7.0.7",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
