# Copy this file to .env for `nuxt dev` and `nuxt preview`, and set the same variables where the site runs.

# Signs the URLs of the share cards (nuxt-og-image). Any 32 or more random characters (`openssl rand -hex 32`).
# A static build (`npm run generate`) draws the cards at build time and needs none.
NUXT_APP_SECRET=

# The address of the live site, for canonical links, the sitemap and share cards. A build on Vercel stops
# while it is still example.com; other builds print a warning. On Vercel, the production address is used when this is empty.
NUXT_PUBLIC_SITE_URL=

# Only for sites with bricks that are not `source: 'files'`. The address of the platform. Set it for Production AND Preview;
# a production build on Vercel stops without it.
NUXT_PUBLIC_GINKO_PLATFORM=

# Only for sites with such bricks. A random secret of at least 32 characters (`openssl rand -hex 32`); with it a publish
# refreshes the site right away. Set it for Production AND Preview.
NUXT_GINKO_REVALIDATE_TOKEN=
