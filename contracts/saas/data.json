    {
      "id": "faq-test",
      "order": 2,
      "data": {
        "question": {
          "de": "Gibt es eine Testphase?"
        },
        "answer": {
          "de": "Alle Tarife können Sie 30 Tage kostenlos testen. Details stehen unter [Preise](/preise)."
        }
      }
    },
    {
      "id": "faq-daten",
      "order": 3,
      "data": {
        "question": {
          "de": "Wo liegen meine Daten?"
        },
        "answer": {
          "de": "Auf Servern in der EU. Mehr dazu in der [Datenschutzerklärung](/datenschutz)."
        }
      }
    },
    {
      "id": "faq-kuendigung",
      "order": 4,
      "data": {
        "question": {
          "de": "Kann ich jederzeit kündigen?"
        },
        "answer": {
          "de": "Ja, zum Monatsende. Ihre Daten exportieren Sie vorher als CSV."
        }
      }
    }
