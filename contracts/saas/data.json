  "blog": [
    {
      "id": "bl-pausen",
      "data": {
        "title": {
          "de": "So rechnen Sie Pausen richtig ab",
          "en": "How to bill breaks correctly",
          "fr": "Décompter les pauses correctement"
        },
        "slug": {
          "de": "pausen-richtig-abrechnen",
          "en": "billing-breaks-correctly",
          "fr": "pauses-decompte-correct"
        },
        "date": "2026-09-30",
        "author": "Lena Ruhland",
        "description": {
          "de": "Wie Pausen im Stundenzettel stehen, damit die Abrechnung stimmt."
        },
        "image": {
          "file": "fl-blog-pausen",
          "alt": {
            "de": "Handwerker mit Tablet auf dem Dach",
            "en": "Tradesman with a tablet on a roof"
