  "faq": [
    {
      "id": "faq-offline",
      "order": 1,
      "data": {
        "question": {
          "de": "Kann ich Taktwerk offline nutzen?",
          "en": "Can I use Taktwerk offline?"
        },
        "answer": {
          "de": "Ja. Stempelungen werden auf dem Handy gespeichert und später übertragen.",
          "en": "Yes. Clock-ins are saved on the phone and sent later."
        }
      },
      "prints": {
        "question": {
          "en": "cc7668994ba57abaf15c79b30a72b4f05eafa239519069d2db21d8e0a5dfae3c"
