        },
        "city": {
          "type": "text",
          "label": "PLZ und Ort",
          "max": 80,
          "translate": false,
          "default": "10999 Berlin",
          "pos": 2
        },
        "email": {
          "type": "text",
          "label": "E-Mail",
          "format": "email",
          "default": "hallo@taktwerk.example",
          "pos": 3
        },
        "phone": {
          "type": "text",
          "label": "Telefon",
          "format": "tel",
          "optional": true,
          "pos": 4
        }
      },
      "pos": 8
