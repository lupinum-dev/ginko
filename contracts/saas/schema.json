    "legal": {
      "kind": "single",
      "label": "Rechtliches",
      "fields": {
        "terms": {
          "type": "markdown",
          "label": "AGB",
          "profile": "basic",
          "translate": "manual",
          "optional": true,
          "max": 30000,
          "pos": 0
        },
        "avv": {
          "type": "markdown",
          "label": "AVV",
          "profile": "basic",
          "translate": "manual",
          "optional": true,
          "max": 30000,
          "pos": 1
        },
        "privacy": {
          "type": "markdown",
          "label": "Datenschutz",
          "profile": "basic",
          "translate": "manual",
          "optional": true,
          "max": 30000,
          "pos": 2
        },
        "imprint": {
          "type": "markdown",
          "label": "Impressum",
          "profile": "basic",
          "translate": "manual",
          "optional": true,
          "max": 30000,
          "pos": 3
