{
  "name": "@lupinum/ginko",
  "version": "0.10.1",
  "description": "Ginko: a typed, file-based content model for Nuxt sites (core, CLI and Nuxt module).",
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/ginko.git",
    "directory": "packages/ginko"
  },
  "homepage": "https://github.com/lupinum-dev/ginko/tree/main/packages/ginko#readme",
  "bugs": {
    "url": "https://github.com/lupinum-dev/ginko/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./vue": "./src/vue.ts",
    "./internal/search": "./src/internal/search.ts",
    "./search": "./src/search.ts",
    "./basics": "./src/basics/index.ts",
    "./nuxt": "./src/nuxt/module.ts"
  },
  "bin": {
    "ginko": "./src/cli/index.ts"
  },
  "files": [
    "dist",
    "i18n",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./internal": {
        "types": "./dist/internal.d.mts",
        "import": "./dist/internal.mjs"
      },
      "./vue": {
        "types": "./dist/vue.d.mts",
        "import": "./dist/vue.mjs"
      },
      "./internal/search": {
        "types": "./dist/internal/search.d.mts",
        "import": "./dist/internal/search.mjs"
      },
      "./search": {
        "types": "./dist/search.d.mts",
        "import": "./dist/search.mjs"
      },
      "./basics": {
        "types": "./dist/basics.d.mts",
        "import": "./dist/basics.mjs"
      },
      "./nuxt": {
        "types": "./dist/nuxt/module.d.mts",
        "import": "./dist/nuxt/module.mjs"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "bin": {
      "ginko": "./dist/cli/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "nuxt": "^4.6.0 || ^5.0.0-0",
    "nuxt-og-image": "^7.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@comark/vue": "0.8.1",
    "@lupinum/ginko-i18n": "workspace:^",
    "@nuxt/kit": "^4.6.0",
    "@zbsearch/stemmers": "4.0.1",
    "comark": "0.8.1",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@lupinum/ginko-content": "workspace:^",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "peerDependenciesMeta": {
    "nuxt-og-image": {
      "optional": true
    }
  }
}
