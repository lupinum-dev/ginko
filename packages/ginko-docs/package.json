{
  "name": "@lupinum/ginko-docs",
  "version": "0.14.0",
  "type": "module",
  "description": "Docs sites on Ginko: a Nuxt layer with navigation, search, blog, changelog and Markdown components.",
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/ginko.git",
    "directory": "packages/ginko-docs"
  },
  "homepage": "https://github.com/lupinum-dev/ginko/tree/main/packages/ginko-docs#readme",
  "bugs": {
    "url": "https://github.com/lupinum-dev/ginko/issues"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "nuxt.config.ts",
    "app",
    "server",
    "shared",
    "icons",
    "public",
    "i18n",
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./config": "./src/config.ts",
    "./pages": "./modules/pages.ts",
    "./icons": "./modules/icons.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./nuxt.config.ts",
      "./config": {
        "types": "./dist/config.d.mts",
        "import": "./dist/config.mjs"
      },
      "./pages": "./dist/pages.mjs",
      "./icons": "./dist/icons.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@comark/vue": "0.8.1",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify/utils": "^3.1.7",
    "@lupinum/ginko-components": "workspace:^",
    "@nuxt/kit": "^4.6.0",
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.18.11"
  },
  "peerDependencies": {
    "@lupinum/ginko": "workspace:^",
    "@lupinum/ginko-content": "workspace:^",
    "@lupinum/ginko-i18n": "workspace:^",
    "nuxt": "^4.6.0 || ^5.0.0-0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@lupinum/ginko": "workspace:*",
    "@lupinum/ginko-content": "workspace:*",
    "@lupinum/ginko-i18n": "workspace:*",
    "nuxt": "4.6.2",
    "unbuild": "3.6.1",
    "vue": "3.5.44"
  }
}
